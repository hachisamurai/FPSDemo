# 复制为Backend/.env.local后填写；真实文件包含凭据，不提交、不截图、不粘贴到聊天。
# MongoDB标准URI或Atlas mongodb+srv URI；若用户名/密码含特殊字符，使用URI百分号编码。
# 多文档事务需要副本集/Atlas；replicaSet和authSource按现有数据库配置填写。
Mongo__ConnectionString=mongodb://USER:PASSWORD@HOST:27017/?replicaSet=REPLICA_SET&authSource=admin
# 本项目专用数据库，建议开发使用fpsdemo_dev；不会清空或重建现有其他数据库。
Mongo__Database=fpsdemo_dev
# 本机API监听地址；连接远程MongoDB不需要把开发API暴露到公网。
ASPNETCORE_URLS=http://127.0.0.1:5087
# 当前单人Demo允许接受离线通关进度，保存来源标记；不是服务端验证的竞技成就。
Profile__AllowOfflineProgress=true
